<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ClaudeBackdrop</AssemblyName>
    <RootNamespace>ClaudeBackdrop</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Claude Backdrop</Product>
    <Description>Wallpaper behind the Claude desktop app</Description>
    <ApplicationIcon>..\..\assets\ClaudeBackdrop.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\ClaudeBackdrop.ico" LogicalName="ClaudeBackdrop.ico" />
  </ItemGroup>
</Project>
