<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Backdrop</AssemblyName>
    <RootNamespace>Backdrop</RootNamespace>
    <Version>2.0.0</Version>
    <Product>Backdrop</Product>
    <Description>Wallpaper behind Claude, Codex, and T3 Code</Description>
    <ApplicationIcon>..\..\assets\Backdrop.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\Backdrop.ico" LogicalName="Backdrop.ico" />
  </ItemGroup>
</Project>