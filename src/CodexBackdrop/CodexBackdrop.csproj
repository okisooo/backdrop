<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CodexBackdrop</AssemblyName>
    <RootNamespace>CodexBackdrop</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Codex Backdrop</Product>
    <Description>Wallpaper behind the Codex desktop app</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\CodexBackdrop.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\CodexBackdrop.ico" LogicalName="CodexBackdrop.ico" />
    <EmbeddedResource Include="Runtime\theme.css" LogicalName="theme.css" />
    <EmbeddedResource Include="Runtime\codex-selectors.css" LogicalName="codex-selectors.css" />
  </ItemGroup>
</Project>
